rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura y escritura completa en todas las colecciones.
    // El acceso al panel de administración docente está protegido por contraseña en la aplicación.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
